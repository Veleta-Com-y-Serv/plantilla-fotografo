---
// Pie «negativo»: banda oscura a todo el ancho con columnas (marca, contacto, menú, redes) y el nombre enorme
// en contorno al final. Todo desde site.yaml. «Web creada con NoExpertise» si marca_pie no es false.
import { site, tel, mapa, whatsapp } from '../data/site';
import Icono from './ui/Icono.astro';
interface Props { variante?: string }
const { variante = 'negativo' } = Astro.props;
const c = site.contacto;
const redes = Object.entries(site.redes).filter(([, url]) => url);
const anio = new Date().getFullYear();
const nombresRed: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn' };
---

<footer class={`pie pie--${variante}`}>
  <div class="contenedor pie-rejilla">
    <div class="pie-marca">
      <p class="pie-nombre">{site.nombre}</p>
      {site.eslogan && <p class="pie-eslogan">{site.eslogan}</p>}
      {c.horario && <p class="mt-4 max-w-sm text-sm opacity-70">{c.horario}</p>}
    </div>
    {
      (c.telefono || c.email || c.direccion || c.whatsapp) && (
        <div>
          <p class="pie-titulo">Contacto</p>
          <ul class="pie-lista">
            {c.telefono && <li><a href={tel(c.telefono)}>{c.telefono}</a></li>}
            {c.whatsapp && <li><a href={whatsapp(c.whatsapp)} rel="noopener" target="_blank">WhatsApp {c.whatsapp}</a></li>}
            {c.email && <li><a href={`mailto:${c.email}`}>{c.email}</a></li>}
            {c.direccion && <li><a href={mapa(c.direccion)} rel="noopener" target="_blank">{c.direccion}</a></li>}
          </ul>
        </div>
      )
    }
    {
      site.menu.length > 0 && (
        <div>
          <p class="pie-titulo">Web</p>
          <ul class="pie-lista">
            {site.menu.map((e) => <li><a href={e.url}>{e.texto}</a></li>)}
          </ul>
        </div>
      )
    }
    {
      redes.length > 0 && (
        <div>
          <p class="pie-titulo">Redes</p>
          <ul class="pie-lista">
            {redes.map(([red, url]) => (
              <li>
                <a href={url} rel="noopener" target="_blank" class="inline-flex min-h-11 items-center gap-2">
                  <Icono nombre={red} tam={18} />
                  {nombresRed[red] ?? red}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
  <div class="contenedor">
    <p class="pie-gigante" aria-hidden="true">{site.nombre}</p>
  </div>
  <div class="contenedor pie-legal">
    <span>© {anio} {site.nombre}</span>
    <a href="/aviso-legal">Aviso legal y privacidad</a>
    {
      site.marca_pie && (
        <span class="pie-noexpertise">
          Web creada con <a href="https://noexpertise.com" rel="noopener">NoExpertise</a>
        </span>
      )
    }
  </div>
</footer>
