---
// Sesiones: banda clara con filas 50/50 en zigzag; la foto toca el borde de la ventana y lleva marcas de visor.
// Lista propia `sesiones: [{nombre, texto, precio, duracion, incluye, imagen, destacado}]`
// (`incluye` con «;»). Sin precio no hay precio; sin foto, la ficha ocupa el ancho del contenido.
// Las sesiones con `detalle` tienen página propia (/sesiones/<nombre>/) y enlazan a ella con «Ver más».
// `destacado: true` marca la sesión con una franja de acento. `cta` opcional al final.
import { seccion, cadena, trozos } from '../../data/site';
import { altFicha } from '../../lib/seo';
import { enlaceDe } from '../../lib/paginas';
import Icono from '../ui/Icono.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const lista = (s?.sesiones ?? []).filter((x) => cadena(x.nombre));
---

{
  s && (
    <section id={Astro.props.id} class="banda-clara seccion" style="padding-bottom:0">
      <div class="contenedor">
        <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      </div>
      {lista.length > 0 && (
        <ol class="sesiones" role="list">
          {lista.map((x, i) => {
            const incluye = trozos(x.incluye);
            const derecha = i % 2 === 1;
            return (
              <li class:list={['sesion', { 'sesion--enlace': !!enlaceDe(x) }, { 'sesion--sin-foto': !x.imagen, 'sesion--derecha': derecha, 'sesion--destacada': x.destacado === true }]}>
                {x.imagen && (
                  <div class="sesion-foto">
                    <Imagen src={x.imagen} alt={altFicha(x)} ancho={1200} alto={900} class="absolute inset-0 h-full w-full object-cover" />
                    <div class="visor" aria-hidden="true"><span /></div>
                  </div>
                )}
                <div class="sesion-texto">
                  <div class="flex items-start justify-between gap-6">
                    <span class="sesion-num contorno" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                    {(cadena(x.duracion) || x.destacado === true) && (
                      <p class="mono mt-3 flex flex-col items-end gap-2 text-right">
                        {x.destacado === true && <span class="sesion-marca" aria-hidden="true" />}
                        {cadena(x.duracion) && <span>{x.duracion}</span>}
                      </p>
                    )}
                  </div>
                  <h3 class="mt-4 text-[clamp(1.9rem,4vw,3.25rem)]">{enlaceDe(x) ? <a href={enlaceDe(x)} class="sesion-enlace">{x.nombre}</a> : x.nombre}</h3>
                  {cadena(x.precio) && <p class="sesion-precio serif mt-3">{x.precio}</p>}
                  {cadena(x.texto) && <p class="mt-5 max-w-lg opacity-80">{x.texto}</p>}
                  {incluye.length > 0 && (
                    <ul class="mt-6 grid gap-x-8 sm:grid-cols-2">
                      {incluye.map((t) => (
                        <li class="sesion-incluye">{t}</li>
                      ))}
                    </ul>
                  )}
                  {enlaceDe(x) && <span class="sesion-ver mono mt-6" aria-hidden="true">Ver más <Icono nombre="flecha" tam={16} /></span>}
                </div>
              </li>
            );
          })}
        </ol>
      )}
      <div class="contenedor py-12 md:py-16">
        {s.cta?.url && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
      </div>
    </section>
  )
}

<style>
  .sesion--enlace { position: relative; }
  .sesion-enlace { text-decoration: none; color: inherit; }
  .sesion-enlace::after { content: ""; position: absolute; inset: 0; }
  .sesion-enlace:focus-visible { outline: none; }
  .sesion--enlace:has(.sesion-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: -4px; }
  .sesion-ver { display: inline-flex; align-items: center; gap: .4rem; color: color-mix(in srgb, var(--c-acento) 70%, currentColor); }
  .sesiones { border-top: 1px solid color-mix(in srgb, currentColor 20%, transparent); }
  .sesion { display: grid; border-bottom: 1px solid color-mix(in srgb, currentColor 20%, transparent); }
  .sesion-foto { position: relative; width: 100%; aspect-ratio: 4 / 3; overflow: hidden; }
  .sesion-texto { padding: 2.25rem 1rem 2.75rem; }
  .sesion--sin-foto .sesion-texto { width: 100%; max-width: var(--ancho); margin-inline: auto; }
  @media (min-width: 768px) {
    .sesion { grid-template-columns: 1fr 1fr; min-height: 34rem; }
    .sesion-foto { aspect-ratio: auto; min-height: 100%; }
    .sesion--derecha .sesion-foto { order: 2; }
    .sesion-texto { padding: 3.5rem clamp(2rem, 5vw, 6rem); align-self: center; max-width: 45rem; }
    .sesion--derecha .sesion-texto { justify-self: end; }
    .sesion--sin-foto { grid-template-columns: 1fr; min-height: 0; }
    .sesion--sin-foto .sesion-texto { padding-inline: 2rem; justify-self: stretch; }
  }
  .sesion-num { font-family: var(--fuente-titulos); font-weight: 900; font-size: clamp(3.5rem, 8vw, 6.5rem); line-height: .8; }
  .sesion-precio { font-size: clamp(1.5rem, 2.6vw, 2.1rem); color: color-mix(in srgb, var(--c-acento) 70%, currentColor); }
  .sesion-marca { width: 3rem; height: .4rem; background: var(--c-acento); }
  .sesion-incluye { display: flex; gap: .75rem; padding-block: .6rem; border-top: 1px solid color-mix(in srgb, currentColor 15%, transparent); font-size: .95rem; }
  .sesion-incluye::before { content: ""; flex: none; width: .5rem; height: .5rem; margin-top: .55rem; background: var(--c-acento); }
  .sesion-foto :global(.visor) { --visor-margen: 1rem; }
</style>
