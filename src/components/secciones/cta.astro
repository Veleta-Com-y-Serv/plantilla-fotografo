---
// Llamada a la acción: banda a todo el ancho con la foto a sangre y un velo, título enorme y dos botones
// (`cta` y `cta_secundario`). Sin foto, banda plena de color de acento.
import { seccion } from '../../data/site';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const conFoto = !!s?.imagen;
---

{
  s && (
    <section id={Astro.props.id} class:list={['llamada relative isolate overflow-hidden', conFoto ? 'llamada--foto' : 'banda-acento']}>
      {conFoto && (
        <>
          <Imagen src={s.imagen} alt="" ancho={1920} alto={900} class="absolute inset-0 -z-20 h-full w-full object-cover" />
          <div class="llamada-velo absolute inset-0 -z-10" aria-hidden="true" />
        </>
      )}
      <div class="contenedor flex min-h-[70svh] flex-col justify-center py-20 md:py-28">
        {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
        {s.titulo && <h2 class="mt-5 max-w-5xl text-[clamp(2.6rem,8vw,7rem)]">{s.titulo}</h2>}
        {s.texto && <p class="mt-6 max-w-xl text-lg md:text-xl">{s.texto}</p>}
        {(s.cta?.url || s.cta_secundario?.url) && (
          <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            {s.cta?.url && <a class="btn" href={s.cta.url}>{s.cta.texto}</a>}
            {s.cta_secundario?.url && (
              <a class="btn-sec" href={s.cta_secundario.url} rel={/^https?:/.test(s.cta_secundario.url) ? 'noopener' : undefined}>
                {s.cta_secundario.texto}
              </a>
            )}
          </div>
        )}
      </div>
    </section>
  )
}

<style>
  .llamada--foto { color: #fff; background: #111; }
  .llamada-velo { background: linear-gradient(90deg, rgb(0 0 0 / .8) 0%, rgb(0 0 0 / .45) 55%, rgb(0 0 0 / .2) 100%); }
</style>
